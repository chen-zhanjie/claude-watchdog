{
  "name": "@chen-zhanjie/claude-watchdog",
  "version": "0.1.3",
  "description": "A minimal watchdog for Claude Code that gently sends continue when output stalls.",
  "type": "module",
  "bin": {
    "claude-watchdog": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "node-pty": "^1.1.0-beta34"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=20"
  }
}
